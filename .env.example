EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_DIR=./app/data/vector_db
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120
API_HOST=127.0.0.1
API_PORT=8000
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SEC=60
# Query timing + LLM usage on /query (set false in production if you prefer)
INCLUDE_DEV_METRICS=true
HYBRID_ENABLED=true
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_DENSE_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
HYBRID_RRF_K=60
